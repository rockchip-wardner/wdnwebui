{
  "id": "video-detection",
  "title": "音视频描述",
  "category": "video",
  "description": "对实时视频流逐帧理解，输出画面与声音的文字描述。",
  "version": "0.1.0",
  "preview_video": "/static/apps/video-detection/preview.mp4",
  "preview_image": "",
  "software_capabilities": [
    "swcap_video_describe",
    "swcap_audio_understand"
  ],
  "hardware_capabilities": [
    "hwcap_video_input",
    "hwcap_audio_input",
    "hwcap_audio_output"
  ],
  "backend": {
    "module": "app.apps.video_detection",
    "register_api": "register_api",
    "register_shutdown": "register_shutdown"
  },
  "frontend": {
    "template": "/static/apps/video-detection/template.html",
    "js": [
      "/static/apps/video-detection/app.js"
    ],
    "css": [
      "/static/apps/video-detection/app.css"
    ]
  },
  "demo_guard": {
    "active_state_keys": [
      "session.state",
      "detector.enabled",
      "audio.state"
    ],
    "stop_endpoints": [
      {
        "method": "POST",
        "path": "/api/video-detection/close"
      },
      {
        "method": "POST",
        "path": "/api/video-detection/prompt/stop"
      },
      {
        "method": "POST",
        "path": "/api/audio-analysis/stop"
      }
    ],
    "stop_sync_endpoints": [
      {
        "method": "POST",
        "path": "/api/video-detection/close"
      },
      {
        "method": "POST",
        "path": "/api/video-detection/prompt/stop"
      },
      {
        "method": "POST",
        "path": "/api/audio-analysis/stop"
      }
    ]
  },
  "prompts": {
    "schema_class": "VLMDoc",
    "editable_fields": [
      {
        "name": "text",
        "label": "VLMDoc.text 字段描述"
      },
      {
        "name": "level",
        "label": "VLMDoc.level 字段描述"
      }
    ],
    "prompt_template": "用中文简洁描述画面，包括场景、人物、动作和环境。"
  },
  "requires_core": [
    "compute.registry",
    "llm.detector_base",
    "video.session"
  ],
  "uploads_dir": "uploads/video_detection",
  "display_order": 1,
  "wizard_config": "wizard.json"
}
