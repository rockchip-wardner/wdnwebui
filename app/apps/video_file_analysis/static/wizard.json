{
  "enabled": true,
  "wizard_title": "视频文件分析快速配置",
  "swcap_to_model": {
    "swcap_video_describe": { "npu_index": 0, "model_id": "qwen3.5-vl-4b" }
  },
  "steps": [
    { "id": "env",    "title": "运行环境检查",  "kind": "env_check" },
    { "id": "source", "title": "视频源",        "kind": "form",
      "fields": [
        { "id": "vfa-source", "ui_key": "source", "label": "视频源 URL / 路径",
          "placeholder": "例 /userdata/clips/sample.mp4" }
      ]
    },
    { "id": "prompt", "title": "分析要求",      "kind": "form",
      "fields": [
        { "id": "vfa-prompt", "ui_key": "prompt", "label": "分析要求", "type": "textarea",
          "placeholder": "例:请对整段视频进行内容总结,给出主题、关键事件与时间线" }
      ]
    },
    { "id": "sample", "title": "采样间隔",      "kind": "form",
      "fields": [
        { "id": "vfa-every-n", "ui_key": "everyN", "label": "采样间隔(每隔多少帧)", "type": "number",
          "placeholder": "默认 60" }
      ]
    },
    { "id": "finish", "title": "完成配置",      "kind": "finish" }
  ]
}