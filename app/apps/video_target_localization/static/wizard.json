{
  "enabled": true,
  "wizard_title": "视频目标定位快速配置",
  "swcap_to_model": {
    "swcap_grounding": { "npu_index": [0, 1], "model_id": "LocateAnything-3b" }
  },
  "open_source_button": "vtl-open",
  "canvas_id": "vtl-grid",
  "upload_endpoint": "/api/video-target-localization/upload",
  "start_buttons": ["vtl-detector-start"],
  "steps": [
    { "id": "env",    "title": "运行环境检查",     "kind": "env_check" },
    { "id": "source", "title": "视频源",           "kind": "form",
      "fields": [
        { "id": "vtl-sources", "ui_key": "source", "label": "视频源（每行一路，最多 32 路）", "type": "textarea" },
        { "id": "vtl-loop",   "ui_key": "loop",   "label": "循环播放", "type": "checkbox", "default": true },
        { "id": "vtl-judge-mode", "ui_key": "judgeMode", "label": "判帧算法（决定哪些帧送去分析）", "type": "select",
          "options": [
            { "value": "manual", "label": "手动跳帧（固定间隔，不比对画面）" },
            { "value": "gscore", "label": "gscore 画面变化（推荐：先消除整幅光照变化，再看结构残差）", "selected": true }
          ]
        },
        { "id": "vtl-judge-threshold", "ui_key": "judgeThreshold", "label": "变化阈值（越小越敏感）", "type": "number",
          "default": 10, "min": "0.1", "step": "0.1",
          "placeholder": "默认 10（刻度按算法不同，切换算法会换成该算法的默认值）" },
        { "id": "vtl-judge-every-n", "ui_key": "judgeEveryN", "label": "帧间隔（有变化时的最长间隔）", "type": "number",
          "default": 600, "min": "1", "max": "3600", "step": "1",
          "placeholder": "默认 600" }
      ]
    },
    { "id": "ground", "title": "定位提示词",       "kind": "form",
      "fields": [
        { "id": "vtl-prompt-rows", "ui_key": "prompts", "label": "定位目标描述",
          "type": "prompt_rows", "min_rows": 1, "max_rows": 20,
          "placeholder": "例:穿着红衬衫的人" }
      ]
    },
    { "id": "finish", "title": "完成配置",          "kind": "finish" }
  ]
}
