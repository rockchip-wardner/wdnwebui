{
  "id": "audio-analysis",
  "title": "音视频分析",
  "category": "audio",
  "description": "视频音轨分段理解 (Qwen2.5-Omni-3B)",
  "version": "0.1.0",
  "hidden": true,
  "preview_video": "",
  "preview_image": "",
  "software_capabilities": [
    "swcap_audio_understand"
  ],
  "hardware_capabilities": [
    "hwcap_audio_input"
  ],
  "backend": {
    "module": "app.apps.audio_analysis",
    "register_api": "register_api",
    "register_shutdown": "register_shutdown"
  },
  "frontend": {
    "template": "/static/apps/audio-analysis/template.html",
    "js": [
      "/static/apps/audio-analysis/app.js"
    ],
    "css": [
      "/static/apps/audio-analysis/app.css"
    ]
  },
  "demo_guard": {
    "active_state_keys": [
      "service.state"
    ],
    "stop_endpoints": [
      {
        "method": "POST",
        "path": "/api/audio-analysis/stop"
      }
    ],
    "stop_sync_endpoints": [
      {
        "method": "POST",
        "path": "/api/audio-analysis/stop"
      }
    ]
  },
  "prompts": {
    "schema_class": "",
    "editable_fields": [],
    "prompt_template": "请转写音频内容并简要描述环境音。"
  },
  "requires_core": [
    "compute.registry"
  ],
  "uploads_dir": "uploads/audio_analysis"
}
