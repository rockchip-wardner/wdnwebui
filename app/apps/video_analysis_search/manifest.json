{
  "id": "video-analysis-search",
  "title": "监控分析检索",
  "category": "video",
  "description": "上传视频做逐帧分析与摘要，并支持自然语言检索片段。",
  "version": "0.2.0",
  "preview_video": "/static/apps/video-analysis-search/preview.mp4",
  "preview_image": "",
  "software_capabilities": [
    "swcap_video_describe",
    "swcap_video_retrieval"
  ],
  "hardware_capabilities": [
    "hwcap_video_input"
  ],
  "backend": {
    "module": "app.apps.video_analysis_search",
    "register_api": "register_api",
    "register_shutdown": "register_shutdown"
  },
  "frontend": {
    "template": "/static/apps/video-analysis-search/template.html",
    "js": [
      "/static/apps/video-analysis-search/app.js"
    ],
    "css": [
      "/static/apps/video-analysis-search/app.css"
    ]
  },
  "demo_guard": {
    "active_state_keys": [
      "analysis.state",
      "search.state",
      "busy"
    ],
    "stop_endpoints": [
      {
        "method": "POST",
        "path": "/api/video-analysis-search/analysis/close"
      },
      {
        "method": "POST",
        "path": "/api/video-analysis-search/analysis/stop"
      },
      {
        "method": "POST",
        "path": "/api/video-analysis-search/search/extract/stop"
      },
      {
        "method": "POST",
        "path": "/api/video-analysis-search/source/close"
      }
    ],
    "stop_sync_endpoints": [
      {
        "method": "POST",
        "path": "/api/video-analysis-search/analysis/close"
      },
      {
        "method": "POST",
        "path": "/api/video-analysis-search/analysis/stop"
      },
      {
        "method": "POST",
        "path": "/api/video-analysis-search/search/extract/stop"
      },
      {
        "method": "POST",
        "path": "/api/video-analysis-search/source/close"
      }
    ]
  },
  "prompts": {
    "schema_class": "VLMDoc",
    "editable_fields": [
      {
        "name": "text",
        "label": "VLMDoc.text 字段描述"
      },
      {
        "name": "level",
        "label": "VLMDoc.level 字段描述"
      }
    ],
    "prompt_template": "请对画面内容进行分析总结"
  },
  "requires_core": [
    "compute.registry",
    "video.session",
    "video.search"
  ],
  "uploads_dir": "uploads/video_analysis_search",
  "display_order": 40,
  "wizard_config": "wizard.json"
}
