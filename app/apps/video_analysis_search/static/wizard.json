{
  "enabled": true,
  "wizard_title": "视频分析检索快速配置",
  "swcap_to_model": {
    "swcap_video_describe":  { "npu_index": 0, "model_id": "qwen3-vl-4b" },
    "swcap_video_retrieval": { "npu_index": 1, "model_id": "qwen3-vl-embedding-2b" }
  },
  "open_source_button": "vcs-open",
  "upload_endpoint": "/api/video-analysis-search/upload",
  "start_buttons": ["vas-start"],
  "steps": [
    { "id": "env",    "title": "运行环境检查", "kind": "env_check" },
    { "id": "source", "title": "视频源",       "kind": "form",
      "fields": [
        { "id": "vcs-source", "ui_key": "source", "label": "视频源 URL / 路径",
          "placeholder": "例 /userdata/test/clips/sample.mp4" },
        { "id": "vcs-loop",   "ui_key": "loop",   "label": "循环播放", "type": "checkbox", "default": true },
        { "id": "vas-judge-mode", "ui_key": "judgeMode", "label": "判帧算法（决定哪些帧送去分析）", "type": "select",
          "options": [
            { "value": "manual", "label": "手动跳帧（固定间隔，不比对画面）" },
            { "value": "gscore", "label": "gscore 画面变化（推荐：先消除整幅光照变化，再看结构残差）", "selected": true }
          ]
        },
        { "id": "vas-judge-threshold", "ui_key": "judgeThreshold", "label": "变化阈值（越小越敏感）", "type": "number",
          "default": 10, "min": "0.1", "step": "0.1",
          "default": 10, "min": "0.1", "step": "0.1",
          "placeholder": "默认 10（刻度按算法不同，切换算法会换成该算法的默认值）" },
        { "id": "vas-judge-every-n", "ui_key": "judgeEveryN", "label": "帧间隔（有变化时的最长间隔）", "type": "number",
          "default": 600, "min": "1", "max": "3600", "step": "1",
          "default": 600, "min": "1", "max": "3600", "step": "1",
          "placeholder": "默认 600" }
      ]
    },
    { "id": "prompt", "title": "分析要求",     "kind": "form",
      "fields": [
        { "id": "vas-prompt", "ui_key": "prompt", "label": "例:请对整段视频进行内容总结,给出主题、关键事件与时间线", "summary_label": "分析要求", "type": "textarea" }
      ]
    },
    { "id": "search", "title": "检索问题",     "kind": "form",
      "fields": [
        { "id": "vcs-text", "ui_key": "searchText", "label": "例:视频里有没有车辆驶出停车场", "summary_label": "检索问题", "type": "textarea" }
      ]
    },
    { "id": "chunk", "title": "切片参数",      "kind": "form",
      "fields": [
        { "id": "vcs-chunk-seconds", "ui_key": "chunkSeconds", "label": "切片时长", "type": "select",
          "options": [
            { "value": "3", "label": "3 秒" },
            { "value": "4", "label": "4 秒", "selected": true },
            { "value": "5", "label": "5 秒" },
            { "value": "6", "label": "6 秒" }
          ]
        },
        { "id": "vcs-chunk-overlap", "ui_key": "chunkOverlap", "label": "重叠", "type": "select",
          "options": [
            { "value": "1", "label": "1 秒", "selected": true },
            { "value": "2", "label": "2 秒" }
          ]
        }
      ]
    },
    { "id": "finish", "title": "完成配置",     "kind": "finish" }
  ]
}
