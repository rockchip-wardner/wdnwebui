{
  "enabled": true,
  "wizard_title": "监控分析检索快速配置",
  "swcap_to_model": {
    "swcap_video_describe":  { "npu_index": 0, "model_id": "qwen3-vl-4b" },
    "swcap_video_retrieval": { "npu_index": 1, "model_id": "qwen3-vl-embedding-2b" }
  },
  "open_source_button": "vcs-open",
  "upload_endpoint": "/api/video-analysis-search/upload",
  "start_buttons": ["vas-start"],
  "steps": [
    { "id": "env",    "title": "运行环境检查", "kind": "env_check" },
    { "id": "source", "title": "视频源",       "kind": "form",
      "fields": [
        { "id": "vcs-source", "ui_key": "source", "label": "视频源 URL / 路径",
          "placeholder": "例 /userdata/test/clips/sample.mp4" },
        { "id": "vcs-loop",   "ui_key": "loop",   "label": "循环播放", "type": "checkbox", "default": true }
      ]
    },
    { "id": "search", "title": "检索问题",     "kind": "form",
      "fields": [
        { "id": "vcs-text", "ui_key": "searchText", "label": "例:视频里有没有车辆驶出停车场", "summary_label": "检索问题", "type": "textarea" }
      ]
    },
    { "id": "finish", "title": "完成配置",     "kind": "finish" }
  ]
}
