{
  "enabled": true,
  "wizard_title": "视频分析检索快速配置",
  "swcap_to_model": {
    "swcap_video_describe":  { "npu_index": 0, "model_id": "qwen3.5-vl-4b" },
    "swcap_video_retrieval": { "npu_index": 1, "model_id": "qwen3-vl-embedding-2b" }
  },
  "start_buttons": ["vas-start"],
  "steps": [
    { "id": "env",    "title": "运行环境检查", "kind": "env_check" },
    { "id": "source", "title": "视频源",       "kind": "form",
      "fields": [
        { "id": "vcs-source", "ui_key": "source", "label": "视频源 URL / 路径",
          "placeholder": "例 /userdata/test/clips/sample.mp4" }
      ]
    },
    { "id": "prompt", "title": "分析要求",     "kind": "form",
      "fields": [
        { "id": "vas-prompt", "ui_key": "prompt", "label": "分析要求", "type": "textarea",
          "placeholder": "例:请对整段视频进行内容总结,给出主题、关键事件与时间线" }
      ]
    },
    { "id": "sample", "title": "采样间隔",     "kind": "form",
      "fields": [
        { "id": "vas-every-n", "ui_key": "everyN", "label": "采样间隔(每隔多少帧)", "type": "number",
          "placeholder": "默认 60" }
      ]
    },
    { "id": "search", "title": "检索问题",     "kind": "form",
      "fields": [
        { "id": "vcs-text", "ui_key": "searchText", "label": "检索问题(可选,填写后自动启用检索)", "type": "textarea",
          "placeholder": "例:视频里有没有车辆驶出停车场" }
      ]
    },
    { "id": "chunk", "title": "切片参数",      "kind": "form",
      "fields": [
        { "id": "vcs-chunk-seconds", "ui_key": "chunkSeconds", "label": "切片时长", "type": "select",
          "options": [
            { "value": "3", "label": "3 秒" },
            { "value": "4", "label": "4 秒", "selected": true },
            { "value": "5", "label": "5 秒" },
            { "value": "6", "label": "6 秒" }
          ]
        },
        { "id": "vcs-chunk-overlap", "ui_key": "chunkOverlap", "label": "重叠", "type": "select",
          "options": [
            { "value": "1", "label": "1 秒", "selected": true },
            { "value": "2", "label": "2 秒" }
          ]
        }
      ]
    },
    { "id": "finish", "title": "完成配置",     "kind": "finish" }
  ]
}
