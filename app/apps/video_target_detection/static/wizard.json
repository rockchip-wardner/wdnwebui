{
  "enabled": true,
  "wizard_title": "视频目标监控快速配置",
  "swcap_to_model": {
    "swcap_video_describe": { "npu_index": 0, "model_id": "qwen3-vl-4b" }
  },
  "open_source_button": "vtd-open",
  "upload_endpoint": "/api/video-target-detection/upload",
  "start_buttons": ["vtd-detector-start"],
  "steps": [
    { "id": "env",    "title": "运行环境检查",           "kind": "env_check" },
    { "id": "source", "title": "视频源",                 "kind": "form",
      "fields": [
{ "id": "vtd-sources", "ui_key": "source", "label": "视频源（每行一路，最多 32 路）", "type": "textarea" },
        { "id": "vtd-loop",   "ui_key": "loop",   "label": "循环播放", "type": "checkbox", "default": true },
        { "id": "vtd-judge-mode", "ui_key": "judgeMode", "label": "判帧算法（决定哪些帧送去分析）", "type": "select",
          "options": [
            { "value": "manual", "label": "手动跳帧（每路按巡检间隔固定送检，不比对画面）" },
            { "value": "gscore", "label": "gscore 画面变化（推荐：先消除整幅光照变化，再看结构残差）", "selected": true }
          ]
        },
        { "id": "vtd-judge-threshold", "ui_key": "judgeThreshold", "label": "变化阈值（越小越敏感）", "type": "number",
          "default": 10, "min": "0.1", "step": "0.1",
          "placeholder": "默认 10（刻度按算法不同，切换算法会换成该算法的默认值）" },
        { "id": "vtd-judge-every-n", "ui_key": "judgeEveryN", "label": "帧间隔（有变化时的最长间隔）", "type": "number",
          "default": 30, "min": "1", "max": "3600", "step": "1",
          "placeholder": "默认 30" }
      ]
    },
    { "id": "detect", "title": "检测提示词 + 检测尺寸",  "kind": "form",
      "fields": [
        { "id": "vtd-prompt",      "ui_key": "prompt",     "label": "例:请检测画面中是否有需要关注的目标", "summary_label": "检测提示词", "type": "textarea" },
        { "id": "vtd-detect-size", "ui_key": "detectSize", "label": "检测尺寸",   "type": "select",
          "options": [
            { "value": "auto", "label": "自动选择",     "selected": true },
            { "value": "384",  "label": "384x384 (更快)" },
            { "value": "768",  "label": "768x768 (更准)" }
          ]
        }
      ]
    },
    { "id": "finish", "title": "完成配置",                "kind": "finish" }
  ]
}
