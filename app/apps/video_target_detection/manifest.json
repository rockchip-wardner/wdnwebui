{
  "id": "video-target-detection",
  "title": "视频目标监控",
  "category": "video",
  "description": "对实时视频流持续检测指定目标是否出现，命中时自动告警并描述。",
  "version": "0.1.0",
  "preview_video": "/static/apps/video-target-detection/preview.mp4",
  "preview_image": "",
  "software_capabilities": [
    "swcap_video_describe"
  ],
  "hardware_capabilities": [
    "hwcap_video_input"
  ],
  "backend": {
    "module": "app.apps.video_target_detection",
    "register_api": "register_api",
    "register_shutdown": "register_shutdown"
  },
  "frontend": {
    "template": "/static/apps/video-target-detection/template.html",
    "js": [
      "/static/apps/video-target-detection/app.js"
    ],
    "css": [
      "/static/apps/video-target-detection/app.css"
    ]
  },
  "demo_guard": {
    "active_state_keys": [
      "session.state",
      "detector.enabled"
    ],
    "stop_endpoints": [
      {
        "method": "POST",
        "path": "/api/video-target-detection/close"
      },
      {
        "method": "POST",
        "path": "/api/video-target-detection/prompt/stop"
      }
    ],
    "stop_sync_endpoints": [
      {
        "method": "POST",
        "path": "/api/video-target-detection/close"
      },
      {
        "method": "POST",
        "path": "/api/video-target-detection/prompt/stop"
      }
    ]
  },
  "prompts": {
    "schema_class": "TargetDoc",
    "editable_fields": [
      {
        "name": "desc",
        "label": "TargetDoc.desc 字段描述"
      }
    ],
    "prompt_template": "请检测画面中是否有需要关注的目标，输出 ROI 框与简短中文描述。"
  },
  "requires_core": [
    "compute.registry",
    "llm.detector_base",
    "video.session"
  ],
  "uploads_dir": "uploads/video_target_detection",
  "display_order": 20,
  "wizard_config": "wizard.json"
}
