{
  "base": {
    "device_name": "JbcpunYC",
    "model_path": "/userdata/models/",
    "resource_dir": "/userdata",
    "hardware_capabilities": {
      "hwcap_video_input": true,
      "hwcap_audio_input": true,
      "hwcap_audio_output": true,
      "hwcap_hdmi_display": true,
    },
  },
  "compute": {
    "services": [
      {
        "name": "qwen3-vl-4b",
        "label": "[VLM]视觉描述v3",
        "autostart": "disabled",
        "device": 1,
      },
      {
        "name": "qwen3-tts",
        "label": "[TTS]文字转语音v3",
        "autostart": "disabled",
        "device": 1,
      },
      {
        "name": "qwen3-4b",
        "label": "[LLM]文字对话v3",
        "autostart": "disabled",
        "device": 1,
      },
      {
        "name": "qwen3-vl-embedding-2b",
        "label": "[VLEmb]视觉信息编码v3",
        "autostart": "disabled",
        "device": 1,
      },
      {
        "name": "qwen2.5-omni-3b",
        "label": "[Omni]多感知描述v2.5",
        "autostart": "disabled",
        "device": 1,
      },
      {
        "name": "qwen3.5-vl-4b",
        "label": "[VLLM]视觉文字多模态v3.5",
        "autostart": "disabled",
        "device": 1,
      },
      {
        "name": "LocateAnything-3b",
        "label": "[GD]视觉定位模型",
        "autostart": "disabled",
        "device": 1,
      },
    ],
  },
  "app": {
    "prompts": {
      "video_detection": {
        "VLMDoc": {
          "text": "用中文一句话描述画面中的场景、主体（人/物）、动作和环境。",
          "level": "严重程度标签：正常 / 警告 / 危险。",
        },
      },
      "video_target_detection": {
        "TargetDoc": {
          "desc": "对目标框内内容的一句话中文描述。",
        },
      },
    },
  },
}
