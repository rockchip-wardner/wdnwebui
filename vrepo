# CLI
# --------------------------------------------------------------------------


EPILOG = """\
命令一览：
  list      列出所有被管理的仓库
  info      逐仓库详细信息（远端 / upstream / 领先落后 / editable 版本）
  status    状态总览（--fetch 先刷新远端跟踪引用）
  sync      并行 fetch + 快进（--rebase / --reinstall / --dry-run）
  fetch     只并行 fetch
  push      并行推送本地提交（--dry-run 预演）
  forall    在每个仓库里跑一条命令（-c 与 repo 同义：命令）
  log       跨仓库合并的提交列表（--since / --author / --grep）
  diff      各仓库工作区差异统计
  grep      跨仓库代码搜索（-i / -l / -m）
  branch    列出各仓库分支
  start     在所有仓库创建并切到同名分支
  checkout  在所有仓库切换分支
  manifest  查看/落盘 manifest（-r 记录 HEAD 快照，-w 写文件）
  init      扫描并生成 .vrepo/manifest.json
  doctor    一致性体检（--net 额外查远端可达性）
  clean     清理未跟踪文件（默认只预览，--force 才真删）
  which     打印仓库绝对路径

示例：
  vrepo status --fetch                 刷新后一屏看清所有仓库
  vrepo sync -j 4 --reinstall          并行同步，必要时重装 editable 包
  vrepo doctor                         体检：版本漂移 / 无 upstream / 脏树
  vrepo forall -c 'git log -1 --oneline'
  vrepo log -n 30 --since '2 weeks ago'
  vrepo grep 'LLMSession' -i
  vrepo manifest -r -w                 记录当前 HEAD 快照到 .vrepo/manifest.json
  vrepo sync -c                        恢复到 manifest 记录的快照
  vrepo start feature/foo --only wdnai

筛选仓库：--only <名称>（可重复） / --skip <名称>（可重复）
"""


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="vrepo",
        description="wdnwebui 工作区多仓库统筹工具（对标 Android repo）",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("-C", "--chdir", help="切换到指定工作区根目录")
    # dest 用 subcommand，避免和 forall 的 --command（dest="command"）撞名
    sub = p.add_subparsers(dest="subcommand", metavar="<command>")

    def add_jobs(sp) -> None:
        sp.add_argument("-j", "--jobs", type=int, help="并发度（默认 min(8, 仓库数)）")

    def add_filters(sp, with_positional: bool = True) -> None:
        sp.add_argument("--only", action="append", help="只对这些仓库操作（可重复）")
        sp.add_argument("--skip", action="append", help="跳过这些仓库（可重复）")
        if with_positional:
            sp.add_argument("projects", nargs="*", help="只对这些仓库操作（仓库名）")

    # ---- list / info / status ------------------------------------------
    sp = sub.add_parser("list", help="列出所有被管理的仓库")
    add_jobs(sp)
    add_filters(sp)

    sp = sub.add_parser("info", help="逐仓库的详细信息")
    add_jobs(sp)
    add_filters(sp)

    sp = sub.add_parser("status", help="所有仓库的状态总览")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("--exit-zero", action="store_true", help="总是以 0 退出")
    sp.add_argument(
        "--fetch", action="store_true", help="先刷新远端跟踪引用（否则 ahead/behind 是旧账）"
    )

    # ---- sync / fetch / push -------------------------------------------
    sp = sub.add_parser("sync", help="并行 fetch + 快进到远端最新")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("-n", "--dry-run", action="store_true", help="只打印将要执行的命令")
    sp.add_argument("--rebase", action="store_true", help="用 pull --rebase 代替 ff-only 合并")
    sp.add_argument("-c", "--checkout", action="store_true", help="先切到 manifest 里 pinned 的 HEAD")
    sp.add_argument("--fetch-only", action="store_true", help="只 fetch，不合并")
    sp.add_argument("--reinstall", action="store_true", help="同步后重装 editable 包")
    sp.add_argument("--with-deps", action="store_true", help="重装时解析依赖（默认 --no-deps）")
    sp.add_argument("--fail-fast", action="store_true", help="一个失败就整体中止")

    sp = sub.add_parser("fetch", help="只并行 fetch，不合并")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("-n", "--dry-run", action="store_true")
    sp.add_argument("--fail-fast", action="store_true")

    sp = sub.add_parser("push", help="并行推送各仓库的本地提交")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("-n", "--dry-run", action="store_true")
    sp.add_argument("--fail-fast", action="store_true")

    # ---- forall ---------------------------------------------------------
    sp = sub.add_parser("forall", aliases=["foreach"], help="在每个仓库里跑一条命令")
    add_jobs(sp)
    add_filters(sp, with_positional=False)
    sp.add_argument(
        "-c",
        "--command",
        dest="command",
        help="要执行的命令（repo 兼容写法，等价于直接写在末尾）",
    )
    sp.add_argument("cmd", nargs=argparse.REMAINDER, help="要执行的命令")
    sp.add_argument("--quiet", action="store_true", help="不打印正常输出")
    sp.add_argument(
        "--no-prefix", dest="prefix", action="store_false", help="输出不加 [仓库名] 前缀"
    )
    sp.add_argument("--fail-fast", action="store_true")

    # ---- log / diff / grep / branch ------------------------------------
    sp = sub.add_parser("log", help="跨仓库合并的提交列表")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("-n", "--max-count", type=int, default=20, help="显示条数")
    sp.add_argument("--since", help="例如 '2 weeks ago'")
    sp.add_argument("--author", help="作者过滤")
    sp.add_argument("--grep", help="提交信息过滤")

    sp = sub.add_parser("diff", help="各仓库工作区差异统计")
    add_jobs(sp)
    add_filters(sp, with_positional=False)
    sp.add_argument("git_args", nargs=argparse.REMAINDER, help="透传给 git diff 的参数")

    sp = sub.add_parser("grep", help="跨仓库代码搜索")
    add_jobs(sp)
    add_filters(sp, with_positional=False)
    sp.add_argument("pattern", help="搜索的模式")
    sp.add_argument("-i", "--ignore-case", action="store_true")
    sp.add_argument("-l", "--files-with-matches", action="store_true")
    sp.add_argument("-m", "--max-count", type=int, help="每个文件的命中上限")
    sp.add_argument("git_args", nargs=argparse.REMAINDER, help="透传给 git grep 的参数")

    sp = sub.add_parser("branch", help="列出各仓库的分支")
    add_jobs(sp)
    add_filters(sp, with_positional=False)
    sp.add_argument("git_args", nargs=argparse.REMAINDER)

    # ---- start / checkout ----------------------------------------------
    sp = sub.add_parser("start", help="在所有仓库创建并切到同名分支")
    add_jobs(sp)
    add_filters(sp, with_positional=False)
    sp.add_argument("branch", help="分支名")
    sp.add_argument("-b", "--base", help="起点（默认当前 HEAD）")

    sp = sub.add_parser("checkout", help="在所有仓库切换分支")
    add_jobs(sp)
    add_filters(sp, with_positional=False)
    sp.add_argument("branch")

    # ---- manifest / init ------------------------------------------------
    sp = sub.add_parser("manifest", help="查看/落盘 manifest")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("-r", "--record", action="store_true", help="把当前 HEAD 记为 pinned")
    sp.add_argument("--refresh", action="store_true", help="重新扫描路径与远端")
    sp.add_argument("-w", "--write", action="store_true", help="写入 .vrepo/manifest.json")
    sp.add_argument("-o", "--output", help="写到指定文件")

    sp = sub.add_parser("init", help="扫描并生成 .vrepo/manifest.json")
    add_jobs(sp)

    # ---- doctor / clean / which ----------------------------------------
    sp = sub.add_parser("doctor", help="工作区一致性体检")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("--net", action="store_true", help="额外检查远端可达性（要联网）")

    sp = sub.add_parser("clean", help="清理各仓库的未跟踪文件（默认只预览）")
    add_jobs(sp)
    add_filters(sp)
    sp.add_argument("-f", "--force", action="store_true", help="真正删除（危险）")
    sp.add_argument("-x", "--ignored", action="store_true", help="连被忽略的文件一起")

    sp = sub.add_parser("which", help="打印指定仓库的绝对路径")
    add_jobs(sp)
    add_filters(sp)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if not args.subcommand:
        parser.print_help()
        return EXIT_OK

    if getattr(args, "chdir", None):
        target = Path(args.chdir).resolve()
        if not target.is_dir():
            die(f"目录不存在: {target}")
        os.chdir(target)
        os.environ["VREPO_ROOT"] = str(target)

    # REMAINDER 里可能带着前导 "--"，去掉
    for attr in ("cmd", "git_args"):
        val = getattr(args, attr, None)
        if val and val[0] == "--":
            setattr(args, attr, val[1:])

    ctx = Context(args)

    dispatch = {
        "list": cmd_list,
        "info": cmd_info,
        "status": cmd_status,
        "sync": cmd_sync,
        "fetch": cmd_fetch,
        "push": cmd_push,
        "forall": cmd_forall,
        "foreach": cmd_forall,
        "log": cmd_log,
        "diff": cmd_diff,
        "grep": cmd_grep,
        "branch": cmd_branch,
        "start": cmd_start,
        "checkout": cmd_checkout,
        "manifest": cmd_manifest,
        "init": cmd_init,
        "doctor": cmd_doctor,
        "clean": cmd_clean,
        "which": cmd_which,
    }
    handler = dispatch.get(args.subcommand)
    if handler is None:
        die(f"未知命令: {args.subcommand}")
    try:
        return handler(ctx)
    except GitError as exc:
        print(C.paint(f"vrepo: {exc}", C.red), file=sys.stderr, flush=True)
        return EXIT_PROBLEM
    except KeyboardInterrupt:
        print(C.paint("\nvrepo: 已中断", C.yellow), file=sys.stderr, flush=True)
        return 130


if __name__ == "__main__":
    sys.exit(main())
